# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Veris demos OFFLINE by default: every key below is enrichment, not a
# dependency. With none of them set, the engine still returns a verdict from
# the local blocklists and offline checks in fixtures/.

# --- Phase 1: URL / domain reputation (optional enrichment) ---
# Google Safe Browsing v4, non-commercial key. Attribution required in the UI:
# "Advisory provided by Google". https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal v3 public key. Free tier is ~4 requests/min -- responses are cached.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_CACHE_TTL_HOURS=24

# --- Phase 2: explanation layer (never decides the verdict) ---
# https://console.groq.com/keys  Unset => templated offline explanation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Phase 5 (stretch): APK static analysis via a local MobSF container ---
MOBSF_URL=http://127.0.0.1:8000
MOBSF_API_KEY=

# --- Demo controls ---
# 1 = refuse all outbound network calls, offline signals only. Use on stage.
VERIS_OFFLINE=0
