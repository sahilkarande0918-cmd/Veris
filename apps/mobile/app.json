{
  "expo": {
    "name": "Veris",
    "slug": "veris",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veris",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.veris.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 5
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.veris.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dbeafe",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      "./plugins/withCallScreening",
      "./plugins/withNotificationGuard",
      "./plugins/withReleaseSigning",
      "./plugins/withHttpsOnly",
      [
        "expo-camera",
        {
          "cameraPermission": "Veris uses the camera only to read a QR code you point it at. Nothing is recorded or uploaded."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class in.veris.app.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "secureScreens": false
    }
  }
}
